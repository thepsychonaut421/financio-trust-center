# Copy to .env.financio.local ON THE TRUST CENTER SERVER; never reuse ERP env.
# This example contains no secrets. Empty credentials must be configured.
TRUST_CENTER_PUBLIC_URL=https://trust.financioflow.com
# Reverse proxy /api/* to loopback backend port4101 and other paths to3101.
# Also used by backend-generated document download links in approval emails.
TRUST_CENTER_PUBLIC_API_URL=https://trust.financioflow.com
TRUST_CENTER_WEB_PORT=3101
TRUST_CENTER_API_PORT=4101

# Dedicated Supabase project/database/auth for Trust Center; not ERP Supabase.
SUPABASE_URL=https://your-trust-center-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-trust-center-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Optional private GitHub read access. No repository administration/write scope.
TRUST_CENTER_SOURCE_REPOSITORY=thepsychonaut421/Financio-Flow-ERP
TRUST_CENTER_GITHUB_TOKEN=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_FROM=
DOCUMENT_UPLOAD_ADMIN_EMAIL_ALLOWLIST=

# OpenAI API provisioning was skipped at the user's request. Drafts use the
# local evidence-based generator. No API key is required or configured here.
# If enabled in a later change, use a dedicated backend key, never NEXT_PUBLIC_*
# and never the Financio Flow integrated-AI key. Salesforce is disabled.
